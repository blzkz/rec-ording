{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rec-ording",
  "version": "0.1.0",
  "identifier": "com.recording.studio3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rec-ording — Estudio de Demos 3D para Google Play & Escritorio",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
