# Maintainer: blzkz <sergiobl88@gmail.com>
pkgname=rec-ording
pkgver=0.10.2
pkgrel=1
pkgdesc="Graba tu móvil Android y conviértelo en un vídeo promocional con marco, fondo y zooms automáticos"
arch=('x86_64')
url="https://github.com/blzkz/rec-ording"
license=('MIT')
depends=('vulkan-icd-loader' 'ffmpeg' 'curl')
optdepends=(
  'scrcpy: grabar el móvil con sonido y sin límite de tiempo (recomendado)'
  'android-tools: detectar el móvil por USB y registrar los toques (adb)'
  'zenity: diálogos para elegir archivos y carpetas'
  'unzip: importar modelos 3D directamente desde el .zip de la descarga'
  'polkit: instalar las actualizaciones desde la app (pkexec)'
)
options=('!debug' '!strip')

package() {
  local root_dir="${startdir}/../.."
  install -Dm755 "${root_dir}/target/release/rec-ording" "${pkgdir}/usr/bin/rec-ording"
  install -Dm644 "${startdir}/rec-ording.desktop" "${pkgdir}/usr/share/applications/rec-ording.desktop"
  # Icono de la app (lanzador y barra de tareas)
  install -Dm644 "${root_dir}/assets/icons/rec-ording.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rec-ording.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "${root_dir}/assets/icons/rec-ording-${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/rec-ording.png"
  done
  install -Dm644 "${root_dir}/assets/icons/rec-ording-256.png" "${pkgdir}/usr/share/pixmaps/rec-ording.png"
  # Licencia de la tipografía de los títulos (va dentro del programa)
  install -Dm644 "${root_dir}/assets/fonts/OFL.txt" "${pkgdir}/usr/share/licenses/${pkgname}/Inter-OFL.txt"

  # Modelos 3D incluidos en la galería (con sus créditos y licencias)
  install -dm755 "${pkgdir}/usr/share/rec-ording/models"
  install -m644 "${root_dir}"/assets/models/*.glb "${root_dir}/assets/models/models.json" "${root_dir}/assets/models/CREDITS.md" \
    "${pkgdir}/usr/share/rec-ording/models/"
}
